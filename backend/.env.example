# ProcurePro Backend Environment Variables
# If DATABASE_URL is left unset or empty, SQLite will be used by default (sqlite:///./procurepro.db)
# DATABASE_URL=postgresql://user:password@localhost:5432/procurepro_db
DATABASE_URL=
PORT=8000
HOST=0.0.0.0
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Local Ollama is the default explanation tier; set to "groq" only to opt into Groq.
LLM_PROVIDER=ollama
# Optional hosted explanation tier. Not used while LLM_PROVIDER=ollama.
GROQ_API_KEY=
# Ollama requires: ollama pull llama3.1:8b
# The rule-based fallback needs no model or network connection.
# Local Tesseract OCR: install the Tesseract program on PATH.
# Set TESSERACT_CMD if it is installed outside PATH; use eng+hin when Hindi data is installed.
OCR_LANG=eng
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
